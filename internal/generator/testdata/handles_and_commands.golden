
type instanceTable struct {
	vkDestroyInstance          unsafe.Pointer
	vkEnumeratePhysicalDevices unsafe.Pointer
	vkGetInstanceVersion       unsafe.Pointer
}

type deviceTable struct {
}

type Instance struct {
	handle  unsafe.Pointer
	table   *instanceTable
	cleanup func()
	parent  any
	retain  *[]any
}

func (h *Instance) Handle() unsafe.Pointer { return h.handle }

type PhysicalDevice struct {
	handle  unsafe.Pointer
	table   *instanceTable
	cleanup func()
	parent  any
	retain  *[]any
}

func (h *PhysicalDevice) Handle() unsafe.Pointer { return h.handle }

type Result int32

const (
	Success              Result = 0
	ErrorOutOfHostMemory Result = -1
)

func (v Result) Error() string {
	switch v {
	case Success:
		return "Success"
	case ErrorOutOfHostMemory:
		return "ErrorOutOfHostMemory"
	default:
		return fmt.Sprintf("Result(%d)", int(v))
	}
}

type StructureType uint32

const (
	StructureTypeInstanceCreateInfo StructureType = 1
)

type cVkInstanceCreateInfo struct {
	sType int32
	pNext unsafe.Pointer
	flags uint32
}

type InstanceCreateInfo struct {
	Next  Structure
	Flags uint32
}

func (s *InstanceCreateInfo) GetType() StructureType {
	return StructureTypeInstanceCreateInfo
}

func (s *InstanceCreateInfo) toC() (unsafe.Pointer, func()) {
	cancels := make([]func(), 0)
	p := new(cVkInstanceCreateInfo)
	p.sType = int32(s.GetType())
	if s.Next != nil {
		nextPtr, nextCancel := s.Next.toC()
		cancels = append(cancels, nextCancel)
		p.pNext = nextPtr
	}
	val0 := uint32(s.Flags)
	p.flags = val0
	return unsafe.Pointer(p), func() {
		for _, cancel := range cancels {
			cancel()
		}
	}
}

func (s *InstanceCreateInfo) fromC(p *cVkInstanceCreateInfo) {
	s.Flags = uint32(p.flags)
}

func CreateInstance(
	CreateInfo *InstanceCreateInfo,
) (*Instance, error) {
	cancels := make([]func(), 0)
	defer func() {
		for _, c := range cancels {
			c()
		}
	}()

	var ptr0 unsafe.Pointer
	if CreateInfo != nil {
		val1, cancel2 := CreateInfo.toC()
		cancels = append(cancels, cancel2)
		ptr0 = val1
	}
	_instanceOutBox := new(unsafe.Pointer)
	var _instanceOutPin runtime.Pinner
	_instanceOutPin.Pin(_instanceOutBox)
	defer _instanceOutPin.Unpin()
	instanceOut := *_instanceOutBox
	_instanceOutSlot := unsafe.Pointer(_instanceOutBox)
	var _ret int32
	ffi.CallFunction(&_cif_vkCreateInstance, _fn_vkCreateInstance, unsafe.Pointer(&_ret), []unsafe.Pointer{
		unsafe.Pointer(&ptr0),
		unsafe.Pointer(&_instanceOutSlot),
	})
	instanceOut = *_instanceOutBox
	if _ret != int32(Success) {
		return nil, Result(_ret)
	}
	h3 := &Instance{handle: unsafe.Pointer(instanceOut)}
	h3.table = _initInstanceTable(instanceOut)
	h3.retain = new([]any)
	if CreateInfo != nil {
		*h3.retain = append(*h3.retain, CreateInfo)
	}
	if h3 != nil {
		runtime.AddCleanup(h3, _cleanupInstance, _cleanupArgsInstance{table: h3.table, retain: h3.retain, handle: h3.handle, trampoline: h3.cleanup})
	}
	return h3, nil
}

func (h *Instance) destroy() {
	cancels := make([]func(), 0)
	defer func() {
		for _, c := range cancels {
			c()
		}
	}()

	_recv := h.handle
	ffi.CallFunction(&_cif_vkDestroyInstance, h.table.vkDestroyInstance, nil, []unsafe.Pointer{
		unsafe.Pointer(&_recv),
	})
}

func (h *Instance) EnumeratePhysicalDevices() ([]*PhysicalDevice, error) {
	cancels := make([]func(), 0)
	defer func() {
		for _, c := range cancels {
			c()
		}
	}()

	_recv := h.handle
	_countBox := new(uint32)
	var _countPin runtime.Pinner
	_countPin.Pin(_countBox)
	defer _countPin.Unpin()
	_countSlot := unsafe.Pointer(_countBox)
	var _nilSlot unsafe.Pointer
	var _ret int32
	ffi.CallFunction(&_cif_vkEnumeratePhysicalDevices, h.table.vkEnumeratePhysicalDevices, unsafe.Pointer(&_ret), []unsafe.Pointer{
		unsafe.Pointer(&_recv),
		unsafe.Pointer(&_countSlot),
		unsafe.Pointer(&_nilSlot),
	})
	if _ret != int32(Success) && _ret != int32(Incomplete) {
		return nil, Result(_ret)
	}
	_count := *_countBox
	if _count == 0 {
		return nil, nil
	}

	_arr := make([]unsafe.Pointer, _count)
	var _arrPin runtime.Pinner
	_arrSlot := unsafe.Pointer(&_arr[0])
	_arrPin.Pin(&_arr[0])
	defer _arrPin.Unpin()

	ffi.CallFunction(&_cif_vkEnumeratePhysicalDevices, h.table.vkEnumeratePhysicalDevices, unsafe.Pointer(&_ret), []unsafe.Pointer{
		unsafe.Pointer(&_recv),
		unsafe.Pointer(&_countSlot),
		unsafe.Pointer(&_arrSlot),
	})
	if _ret != int32(Success) {
		return nil, Result(_ret)
	}

	_count = *_countBox
	if int(_count) > len(_arr) {
		_count = uint32(len(_arr))
	}
	out := make([]*PhysicalDevice, int(_count))
	_arr = _arr[:_count]
	for i, v := range _arr {
		h0 := &PhysicalDevice{handle: unsafe.Pointer(v)}
		out[i] = h0
		h0.table = h.table
	}
	return out, nil
}

func (h *Instance) GetVersion() uint32 {
	cancels := make([]func(), 0)
	defer func() {
		for _, c := range cancels {
			c()
		}
	}()

	_recv := h.handle
	_versionOutBox := new(uint32)
	var _versionOutPin runtime.Pinner
	_versionOutPin.Pin(_versionOutBox)
	defer _versionOutPin.Unpin()
	versionOut := *_versionOutBox
	_versionOutSlot := unsafe.Pointer(_versionOutBox)
	ffi.CallFunction(&_cif_vkGetInstanceVersion, h.table.vkGetInstanceVersion, nil, []unsafe.Pointer{
		unsafe.Pointer(&_recv),
		unsafe.Pointer(&_versionOutSlot),
	})
	versionOut = *_versionOutBox
	val0 := uint32(versionOut)
	return val0
}

// ---------------------------------------------------------------------------
// Handle cleanups
//
// Each handle is destroyed by the garbage collector through a runtime.AddCleanup
// registered at creation. Cleanup arguments hold the parent handle so parents
// outlive their children, and never the handle being destroyed.
// ---------------------------------------------------------------------------

type _cleanupArgsInstance struct {
	table      *instanceTable
	keepAlive  any
	retain     *[]any
	handle     unsafe.Pointer
	trampoline func()
}

func _cleanupInstance(a _cleanupArgsInstance) {
	if a.handle == nil {
		return
	}
	_cleanupMu.Lock()
	defer _cleanupMu.Unlock()
	_self := &Instance{handle: a.handle, table: a.table, cleanup: a.trampoline}
	_self.destroy()
}

var _cif_vkCreateInstance types.CallInterface
var _fn_vkCreateInstance unsafe.Pointer
var _cif_vkDestroyInstance types.CallInterface
var _cif_vkEnumeratePhysicalDevices types.CallInterface
var _cif_vkGetInstanceVersion types.CallInterface

func _initInstanceTable(handle unsafe.Pointer) *instanceTable {
	_vkGetDeviceProcAddr = _loadProc(handle, "vkGetDeviceProcAddr")
	t := &instanceTable{}
	t.vkDestroyInstance = _loadProc(handle, "vkDestroyInstance")
	t.vkEnumeratePhysicalDevices = _loadProc(handle, "vkEnumeratePhysicalDevices")
	t.vkGetInstanceVersion = _loadProc(handle, "vkGetInstanceVersion")
	return t
}

func _initDeviceTable(handle unsafe.Pointer) *deviceTable {
	t := &deviceTable{}
	return t
}

// Initialize loads the Vulkan library and global function pointers.
// Must be called before any other Vulkan function.
// Instance and device function pointers are loaded automatically
// by CreateInstance and CreateDevice respectively.
func Initialize() error {
	lib, err := ffi.LoadLibrary(_vulkanLibName())
	if err != nil {
		return fmt.Errorf("vulkan: %w", err)
	}
	_vkLib = lib

	gipaFn, err := ffi.GetSymbol(lib, "vkGetInstanceProcAddr")
	if err != nil {
		return fmt.Errorf("vulkan: %w", err)
	}
	_vkGetInstanceProcAddr = gipaFn
	ffi.PrepareCallInterface(&_cif_vkGetInstanceProcAddr, types.DefaultCall, types.PointerTypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor, types.PointerTypeDescriptor}) //nolint
	ffi.PrepareCallInterface(&_cif_vkGetDeviceProcAddr, types.DefaultCall, types.PointerTypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor, types.PointerTypeDescriptor})   //nolint

	// Load global commands
	_fn_vkCreateInstance = _loadProc(nil, "vkCreateInstance")

	// Prepare all call interfaces
	ffi.PrepareCallInterface(&_cif_vkCreateInstance, types.DefaultCall, types.SInt32TypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor, types.PointerTypeDescriptor})                                        //nolint
	ffi.PrepareCallInterface(&_cif_vkDestroyInstance, types.DefaultCall, types.VoidTypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor})                                                                      //nolint
	ffi.PrepareCallInterface(&_cif_vkEnumeratePhysicalDevices, types.DefaultCall, types.SInt32TypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor, types.PointerTypeDescriptor, types.PointerTypeDescriptor}) //nolint
	ffi.PrepareCallInterface(&_cif_vkGetInstanceVersion, types.DefaultCall, types.VoidTypeDescriptor, []*types.TypeDescriptor{types.PointerTypeDescriptor, types.PointerTypeDescriptor})                                      //nolint

	return nil
}
